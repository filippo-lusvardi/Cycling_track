rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's profile (intervals.icu key, settings), saved segments and, for accounts without intervals.icu,
    // their rides, wellness and calendar: theirs alone.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Forests: friends' trees side by side. Only members see a forest; a link's secret key lets someone ask to
    // join, and any member approves. Each member writes only their own tree, times and settings.
    match /forests/{fid} {
      function signedIn() { return request.auth != null; }
      function me() { return request.auth.uid; }
      function forest() { return get(/databases/$(database)/documents/forests/$(fid)).data; }
      function isMember() { return signedIn() && me() in forest().members; }
      function asked(uid) { return exists(/databases/$(database)/documents/forests/$(fid)/requests/$(uid)); }

      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["name", "createdBy", "createdAt", "members", "sport"])
        // Missing means cycling. It can't change afterwards: `update` below doesn't allow it.
        && (!("sport" in request.resource.data) || request.resource.data.sport == "run")
        && request.resource.data.createdBy == me()
        && request.resource.data.members == [me()]
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "name", "climbsAt"])
        // Stamped when a climb is added or removed, so members' apps re-read climbs only then.
        && (!("climbsAt" in request.resource.data) || request.resource.data.climbsAt is number)
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.members.size() <= 30
        && membersChangeOk(resource.data, request.resource.data.members);
      // The last member leaving takes the forest with them.
      allow delete: if signedIn() && resource.data.members == [me()];

      // At most one newcomer at a time, and only one who asked; members leave by themselves (the creator may also
      // remove someone).
      function membersChangeOk(before, after) {
        // Lists, not sets: a set can't be indexed, so the newcomer is read as added[0].
        let added = after.removeAll(before.members);
        let removed = before.members.removeAll(after);
        return added.size() <= 1
          && (added.size() == 0 || asked(added[0]))
          && (removed.size() == 0 || removed == [me()] || before.createdBy == me());
      }

      match /invites/{key} {
        allow get: if signedIn();
        allow list, create, delete: if isMember();
      }

      match /requests/{uid} {
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(["name", "key", "at", "consentAt", "sharePast", "shareRoutes", "shareEffort"])
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && exists(/databases/$(database)/documents/forests/$(fid)/invites/$(request.resource.data.key));
        allow read, delete: if isMember() || (signedIn() && me() == uid);
      }

      match /members/{uid} {
        allow read: if isMember();
        // Created by the member themselves (the creator) or by whoever approves their request.
        allow create: if isMember() && (me() == uid || asked(uid));
        allow update: if isMember() && me() == uid;
        allow delete: if signedIn() && (me() == uid || forest().createdBy == me());
      }

      match /trees/{uid} {
        allow read: if isMember();
        allow write: if isMember() && me() == uid;
        allow delete: if signedIn() && me() == uid;
        match /years/{year} {
          allow read: if isMember();
          allow write: if isMember() && me() == uid;
          allow delete: if signedIn() && me() == uid;
        }
        // A shared ride's page: summary, the route with its ends hidden if the member shares maps, heart rate and power
        // if they share those.
        match /rides/{ride} {
          allow read: if isMember();
          allow write: if isMember() && me() == uid;
          allow delete: if signedIn() && me() == uid;
        }
      }

      match /segments/{sid} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.addedBy == me();
        // By whoever added it, the creator, or the last member leaving.
        allow delete: if isMember()
          && (resource.data.addedBy == me() || forest().createdBy == me() || forest().members == [me()]);
        match /times/{uid} {
          allow read: if isMember();
          allow write: if isMember() && me() == uid;
          allow delete: if signedIn() && me() == uid;
        }
      }
    }

    // OpenStreetMap names for climbs, shared by every signed-in user. A found name is never replaced by "none".
    // Today's season for the phone launcher: anyone with the link (the long random key) can read that one
    // document, no listing; only its owner writes it.
    match /accents/{key} {
      allow get: if true;
      allow create: if request.auth != null && key.size() >= 24 && validAccent();
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && validAccent();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      function validAccent() {
        let d = request.resource.data;
        return d.keys().hasOnly(["uid", "season", "color", "day", "at"])
          && d.uid == request.auth.uid
          && d.season in ["spring", "summer", "autumn", "winter"]
          && d.color is string && d.color.matches("^#[0-9A-Fa-f]{6}$")
          && d.day is string && d.day.size() == 10
          && d.at is number;
      }
    }

    match /places/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validPlace();
      allow update: if request.auth != null && validPlace()
        && (request.resource.data.name is string || resource.data.name == null);

      function validPlace() {
        let d = request.resource.data;
        return d.keys().hasOnly(["name", "at"]) && d.at is number
          && (d.name == null || (d.name is string && d.name.size() <= 120));
      }
    }
  }
}
