rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's profile (intervals.icu key, settings) and saved segments: theirs alone.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /segments/{segmentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // OpenStreetMap names for climbs, shared by every signed-in user. A found name is never replaced by "none".
    match /places/{key} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validPlace();
      allow update: if request.auth != null && validPlace()
        && (request.resource.data.name is string || resource.data.name == null);

      function validPlace() {
        let d = request.resource.data;
        return d.keys().hasOnly(["name", "at"]) && d.at is number
          && (d.name == null || (d.name is string && d.name.size() <= 120));
      }
    }
  }
}
